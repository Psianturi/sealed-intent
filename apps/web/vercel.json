{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "/verify.html"
    },
    {
      "source": "/a/:id",
      "destination": "/agent.html"
    },
    {
      "source": "/try",
      "destination": "/try.html"
    },
    {
      "source": "/checkup",
      "destination": "/checkup.html"
    },
    {
      "source": "/start",
      "destination": "/start.html"
    },
    {
      "source": "/proof",
      "destination": "/proof.html"
    },
    {
      "source": "/approve/:id",
      "destination": "/approve.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
