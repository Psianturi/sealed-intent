# Copy to .env for LIVE mode. Offline demo needs none of these.

# 32-byte hex key that encrypts the secret policy at rest (generate: openssl rand -hex 32)
SEALED_POLICY_KEY=

# NEAR Intents 1Click API. JWT is optional (without it 1Click charges a 0.2% fee).
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# NEAR AI Cloud (private intent check inside a TEE)
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash
# Intel collateral source for quote verification (default: Phala PCCS). Intel: https://api.trustedservices.intel.com
SEALED_PCCS_URL=

# Which chain this instance pays on: mainnet or testnet
SEALED_NETWORK=mainnet

# OutLayer Agent Custody (keys stay in a TDX enclave; mainnet for Intents routes)
# Testnet host: https://testnet-api.outlayer.ai
OUTLAYER_BASE_URL=https://api.outlayer.ai
OUTLAYER_API_KEY=
# The wallet's NEAR account, from registration. Reconciliation watches it.
OUTLAYER_NEAR_ACCOUNT=
# A key on the owner's account limited to freeze_wallet (pnpm custody freeze-key). It can stop the wallet and do nothing else.
SEIN_FREEZE_ACCOUNT=
SEIN_FREEZE_KEY=
SEALED_RECONCILE_INTERVAL_MS=60000

# Public registry. The operator key can add receipt batches and issuer keys, nothing else.
SEIN_REGISTRY_ACCOUNT=
SEIN_OPERATOR_ACCOUNT=
SEIN_OPERATOR_KEY=
SEALED_ANCHOR_INTERVAL_MS=600000
# Public registry ids for agents whose owner made them public: "internal-name=agent-1"
SEALED_AGENT_REGISTRY=

# When set, approving a WARN needs this account's wallet signature; the owner token is not enough
SEALED_OWNER_ACCOUNT=
# The approve page: where it lives, which sites may call this gateway from a browser, and how the owner's browser reaches it
SEALED_WEB_URL=https://sein-near.vercel.app
SEALED_WEB_ORIGINS=https://sein-near.vercel.app
SEALED_PUBLIC_URL=http://127.0.0.1:8787

# NEAR RPC endpoints, comma separated. If two disagree about an account, a human decides.
NEAR_RPC_URLS=https://rpc.mainnet.near.org,https://free.rpc.fastnear.com
NEAR_RPC_URL=https://free.rpc.fastnear.com

# Accounts to watch for keys or code that did not go through Sealed Intent (comma separated). A change freezes the wallet.
SEALED_WATCH_ACCOUNTS=
SEALED_WATCH_INTERVAL_MS=30000
# Optional: POST a JSON alert here when the watcher freezes the wallet
SEALED_ALERT_WEBHOOK=

# Encrypts private data at rest. Defaults to SEALED_POLICY_KEY; live mode refuses to run without one of them.
SEALED_DATA_KEY=

# Who may call the REST API: "token=agentId,token2=agentId2". Offline mode without this accepts anyone as offline-agent.
SEALED_AGENT_TOKENS=
# Only this token can approve or reject WARN decisions. Generated and printed once if unset.
SEALED_OWNER_TOKEN=
# Owner kill switch: POST /v1/freeze and /v1/unfreeze with the owner token.
# Agent name for the in-process MCP server (offline demo only)
SEALED_AGENT_ID=mcp-agent

# --- agent host only, never next to the secrets above ---
# SEALED_REST_URL=http://127.0.0.1:8787
# SEALED_AGENT_TOKEN=<one token from SEALED_AGENT_TOKENS, or from pnpm owner agent-issue>
# SEALED_AGENT_SIGNING_KEY=<32-byte hex seed; the server then refuses this agent's unsigned requests>
