# Copy to .env for LIVE mode. Offline demo needs none of these.

# 32-byte hex key that encrypts the secret policy at rest (generate: openssl rand -hex 32)
SEALED_POLICY_KEY=

# NEAR Intents 1Click API. JWT is optional (without it 1Click charges a 0.2% fee).
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# NEAR AI Cloud (private intent check inside a TEE)
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_MODEL=

# OutLayer Agent Custody (keys stay in a TDX enclave; mainnet for Intents routes)
OUTLAYER_BASE_URL=https://api.outlayer.ai
OUTLAYER_API_KEY=

# NEAR RPC used for read-only views (storage checks)
NEAR_RPC_URL=https://rpc.mainnet.near.org
