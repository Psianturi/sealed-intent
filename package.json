{
  "name": "sealed-intent",
  "version": "0.1.0",
  "private": true,
  "description": "A private preflight checker between AI agents and their money on NEAR Intents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "redteam": "tsx packages/redteam/src/cli.ts",
    "verify": "tsx packages/receipt/src/cli.ts",
    "disclose": "tsx packages/receipt/src/disclose-cli.ts",
    "rest": "tsx apps/server/src/rest.ts",
    "mcp": "tsx apps/server/src/mcp.ts",
    "policy:seal": "tsx scripts/seal-policy.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "arena:run": "tsx packages/arena/src/cli.ts run",
    "arena:replay": "tsx packages/arena/src/cli.ts replay",
    "arena:verify": "tsx packages/arena/src/cli.ts verify",
    "arena:storyboard": "tsx apps/web/scripts/storyboard.ts",
    "web:dev": "pnpm --filter @sealed-intent/web dev",
    "web:build": "pnpm --filter @sealed-intent/web build",
    "sein": "tsx scripts/sein.ts",
    "owner": "tsx scripts/owner.ts",
    "secret:scan": "node scripts/secret-scan.mjs",
    "custody": "tsx scripts/custody.ts",
    "gateway:check": "tsx scripts/gateway-check.ts",
    "registry": "tsx scripts/registry.ts",
    "custody:check": "tsx scripts/custody-check.ts",
    "custody:flow": "tsx scripts/custody-flow.ts",
    "custody:approval": "tsx scripts/approval-evidence.ts",
    "checkup:patient": "tsx scripts/checkup-patient.ts",
    "mcp:agent": "tsx apps/server/src/mcp-agent.ts",
    "hosted": "tsx apps/server/src/hosted.ts",
    "deploy:cloudrun": "bash scripts/deploy-cloudrun.sh",
    "tee:live": "tsx scripts/tee-live.ts",
    "isolation:check": "bash scripts/isolation-check.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.15.0",
    "near-kit": "^0.20.2",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
